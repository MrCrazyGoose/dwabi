# Required in production: long random string used to sign login tokens.
SESSION_SECRET=change-me
# Optional: use PostgreSQL instead of the JSON file store.
# DATABASE_URL=postgres://user:password@localhost:5432/mocobin
# Optional: JSON file location when DATABASE_URL is not set (default data/ecosort.json).
# DATA_FILE=./data/ecosort.json
PORT=3001
# AI photo checks (scanner and bin night). Leave unset to use the on-device model only.
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-opus-5-5
# VISION_EFFORT=low
# Competition window (Eastern time, inclusive).
COMPETITION_NAME=Fall 2026 Zero-Waste Challenge
COMPETITION_START=2026-09-01
COMPETITION_END=2026-12-18
